<RCC>
    <qresource prefix="/images">
        <file alias="logo.png">images/CppIDE_Assets/logo_cpp.png</file>
        <file alias="mascot.png">images/CppIDE_Assets/icon_monkey.png</file>
        <file alias="mascot_laptop.png">images/CppIDE_Assets/mascot_laptop.png</file>
        <file alias="run.png">images/CppIDE_Assets/icon_play.png</file>
        <file alias="stop.png">images/CppIDE_Assets/icon_stop.png</file>
        <file alias="terminal.png">images/CppIDE_Assets/icon_terminal.png</file>
        <file alias="theme.png">images/CppIDE_Assets/icon_theme.png</file>
        <file alias="settings.png">images/CppIDE_Assets/icon_settings.png</file>
        <file alias="debug.png">images/CppIDE_Assets/icon_debug.png</file>
        <file alias="bug.png">images/CppIDE_Assets/icon_bug.png</file>
        <file alias="tools.png">images/CppIDE_Assets/icon_tools.png</file>
        <file alias="plugins.png">images/CppIDE_Assets/icon_plugins.png</file>
        <file alias="cursor.png">images/CppIDE_Assets/icon_cursor.png</file>
        <file alias="folder.png">images/CppIDE_Assets/folders_folder.png</file>
        <file alias="folder_new.png">images/CppIDE_Assets/folders_new.png</file>
        <file alias="folder_open.png">images/CppIDE_Assets/folders_open.png</file>
        <file alias="folder_more.png">images/CppIDE_Assets/folders_more.png</file>
        <file alias="file_cpp.png">images/CppIDE_Assets/file_cpp.png</file>
        <file alias="file_config.png">images/CppIDE_Assets/file_config.png</file>
        <file alias="file_text.png">images/CppIDE_Assets/file_text.png</file>
        <file alias="file_run.png">images/CppIDE_Assets/file_run.png</file>
    </qresource>
    <qresource prefix="/themes">
        <file alias="dark.qss">themes/dark.qss</file>
        <file alias="light.qss">themes/light.qss</file>
    </qresource>
</RCC>
